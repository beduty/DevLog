# Primal 진행사항

filters:
  and:
    - note["base"] == link("Primal 진행사항.base")
properties:
  file.name:
    displayName: Name
  URL:
    displayName: URL
  생성날짜:
    displayName: 생성날짜
  Created:
    displayName: Created
  Tags:
    displayName: Tags
views:
  - type: table
    name: Table View
    order:
      - file.name
      - URL
      - 생성날짜
      - Created
      - Tags
